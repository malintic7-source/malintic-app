# ⚠️ SÉCURITÉ CRITIQUE: JAMAIS versionner .env avec les vraies valeurs
# Copier .env.example → .env et remplir les valeurs locales seulement

# ═══════════════════════════════════════════════════════════════════════════════
# 🔧 DOCKER & COMPOSE
# ═══════════════════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=gestion_formations

# Admin par défaut (Premier login - À CHANGER IMMÉDIATEMENT EN PRODUCTION)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=your_secure_password_here

# ═══════════════════════════════════════════════════════════════════════════════
# 🌐 BACKEND NODE.JS (server/server.js)
# ═══════════════════════════════════════════════════════════════════════════════

# ⚠️ CRITIQUE: Ne jamais utiliser boil-prude-curry.ngrok-free.dev en dur
# Chaque admin doit avoir son propre domaine ngrok
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-custom-domain.ngrok-free.dev

# Public URL du frontend (pour redirects, cookies sécurisés)
PUBLIC_URL=http://localhost:8000

# Origines CORS autorisées (séparées par virgules)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://192.168.1.x:8000

# Répertoire de données (Docker: /data)
DATA_DIR=/data

# Environnement
NODE_ENV=development

# Port serveur
PORT=5001

# ═══════════════════════════════════════════════════════════════════════════════
# 🔐 SUPABASE (optionnel - Laisser vide si non utilisé)
# ═══════════════════════════════════════════════════════════════════════════════

# ⚠️ CRITIQUE: Les credentials Supabase ne doivent JAMAIS être hardcodées
# Laisser VIDE en production SAUF si vous utilisez VRAIMENT Supabase

# À passer au build Flutter via --dart-define:
#   flutter build web --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Clé service_role réservée au backend Docker/Render, jamais au frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# ☁️ CLOUDFLARE (optionnel)
# ═══════════════════════════════════════════════════════════════════════════════

CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

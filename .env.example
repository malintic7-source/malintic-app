# ⚠️ SÉCURITÉ CRITIQUE: JAMAIS versionner .env avec les vraies valeurs
# Copier .env.example → .env et remplir les valeurs locales seulement

# ═══════════════════════════════════════════════════════════════════════════════
# 🔧 DOCKER & COMPOSE
# ═══════════════════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=gestion_formations

# Admin par défaut (Premier login - À CHANGER IMMÉDIATEMENT EN PRODUCTION)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=your_secure_password_here

# ═══════════════════════════════════════════════════════════════════════════════
# 🌐 BACKEND NODE.JS (server/server.js)
# ═══════════════════════════════════════════════════════════════════════════════

# ⚠️ CRITIQUE: Ne jamais utiliser boil-prude-curry.ngrok-free.dev en dur
# Chaque admin doit avoir son propre domaine ngrok
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-custom-domain.ngrok-free.dev

# Public URL du frontend (pour redirects, cookies sécurisés)
PUBLIC_URL=http://localhost:8000

# Origines CORS autorisées (séparées par virgules)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://192.168.1.x:8000

# Répertoire de données (Docker: /data)
DATA_DIR=/data

# Environnement
NODE_ENV=development

# Port serveur
PORT=5001

# ═══════════════════════════════════════════════════════════════════════════════
# 🐘 POSTGRES LOCAL (Docker)
# ═══════════════════════════════════════════════════════════════════════════════

POSTGRES_DB=malintic
POSTGRES_USER=malintic
POSTGRES_PASSWORD=change_me_to_a_strong_local_password
DATABASE_URL=postgresql://malintic:change_me_to_a_strong_local_password@postgres:5432/malintic
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_to_a_strong_pgadmin_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_a_strong_grafana_password

# ═══════════════════════════════════════════════════════════════════════════════
# ☁️ NGROK / TUNNEL (seul accès distant autorisé)
# ═══════════════════════════════════════════════════════════════════════════════

NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-custom-domain.ngrok-free.dev
CLOUDFLARE_TUNNEL_TOKEN=

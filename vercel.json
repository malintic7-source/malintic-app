{
  "version": 2,
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://boil-prude-curry.ngrok-free.dev/api/$1"
    },
    {
      "src": "/formation.html",
      "dest": "/formation.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(?:js|css|json|png|jpg|jpeg|svg|ico|ttf|otf|woff|woff2|wasm))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

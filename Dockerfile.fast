# Fast Runtime with nginx (serving prebuilt Flutter web)
FROM nginx:alpine

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built web files
COPY build/web /usr/share/nginx/html
# The public QR registration page is maintained outside Flutter's build output.
COPY web/formation.html /usr/share/nginx/html/formation.html

# Remove default nginx configs backup if any
RUN rm -f /etc/nginx/conf.d/default.conf.bak

# Health check
HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
